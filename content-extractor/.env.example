# ==== Cấu hình nhanh từ UI (Settings dialog ⚙️ AI trên header) ====
# Provider/baseURL/model/thinking đổi được từ UI, lưu vào .settings.json (gitignored) và
# ƯU TIÊN hơn toàn bộ block Vision/Script bên dưới (kể cả SCRIPT_API_KEY/SCRIPT_BASE_URL).
# API key KHÔNG lưu trong .settings.json — key luôn khai ở đây, chọn theo provider:
#   OpenAI / Custom : OPENAI_API_KEY
#   Z.AI            : ZAI_API_KEY        (thiếu → fallback OPENAI_API_KEY)
#   OpenRouter      : OPENROUTER_API_KEY (thiếu → fallback OPENAI_API_KEY)
# Khai sẵn mọi key một lần rồi đổi provider tự do trong UI, không phải sửa file này nữa.
# Nút "Dùng theo ENV" trong dialog xóa .settings.json → quay về đúng cấu hình dưới đây.
# Test/e2e: đặt SETTINGS_FILE=/dev/null để chạy ENV thuần, không ăn .settings.json của dev.
#ZAI_API_KEY=
#OPENROUTER_API_KEY=

# ==== Vision LLM (OpenAI-compatible) ====
# Bắt buộc. API key của nhà cung cấp vision.
OPENAI_API_KEY=

# Endpoint OpenAI-compatible. Bỏ trống / xóa dòng = dùng OpenAI mặc định (https://api.openai.com/v1).
# Đổi nhà cung cấp CHỈ bằng ENV, không sửa code.
#   OpenAI                   : https://api.openai.com/v1
#   Z.AI (trả theo token)    : https://api.z.ai/api/paas/v4
#   Z.AI (gói Coding Plan)   : https://api.z.ai/api/coding/paas/v4
OPENAI_BASE_URL=https://api.openai.com/v1

# Model vision. LƯU Ý: phải là model của đúng nhà cung cấp ở trên (model OpenAI như
# gpt-4o-mini KHÔNG tồn tại trên Z.AI → lỗi 400 Unknown Model).
#   OpenAI : gpt-4o-mini (rẻ) / gpt-4o
#   Z.AI   : glm-4.5v hoặc glm-4.6v (model vision; glm-5v-turbo cần gói cao hơn)
VISION_MODEL=gpt-4o-mini

# Cạnh dài tối đa của ảnh gửi lên model (px). Ảnh được downscale trước khi encode base64.
# Ảnh dải dọc (webtoon slice, ratio ≥ STRIP_RATIO) chỉ kẹp BỀ RỘNG theo ngưỡng này,
# giữ nguyên chiều cao để stitch/cắt band không mất chữ; payload vision vẫn luôn ≤ MAX_EDGE.
MAX_EDGE=1568

# Số ảnh gọi vision đồng thời.
VISION_CONCURRENCY=4

# Nhịp tối đa khi bấm "Chạy" (requests/phút) — chặn 429 chủ động bằng cách giãn thời điểm bắt đầu
# mỗi request (vd 30 → cách nhau ≥ 2000ms). Chỉnh nhanh mỗi lượt bằng ô "Nhịp" cạnh nút Chạy.
VISION_RPM=30

# Tắt "thinking/reasoning" của model reasoning (vd GLM z.ai) để tiết kiệm ~50% token và
# chạy nhanh hơn khi xử lý hàng loạt trang. Đặt true khi dùng z.ai; bỏ trống/false cho OpenAI.
VISION_DISABLE_THINKING=false

# ==== Storyboard (Stage 1.5) ====
# Render PDF: hệ số phóng (1 = 72dpi). 2 đủ nét trước khi downscale theo MAX_EDGE.
PDF_SCALE=2

# Ảnh có tỉ lệ cao/rộng ≥ ngưỡng này được coi là dải dọc (webtoon strip);
# đa số ảnh trong job là dải dọc → job chạy nhánh stitch + smart-split.
STRIP_RATIO=2.5

# Cắt band theo NGỮ CẢNH (kế thừa primitive safe-line của SmartStitch, jhin1m/manhwa-sticher):
# tìm "gutter" (khoảng trắng ngang liên tục DÀY) làm điểm cắt và bỏ qua khe hẹp giữa nhân vật
# với bong bóng thoại của họ → mỗi band có xu hướng chứa trọn một đơn vị nội dung. Thay thuật
# toán cũ (chia mỗi ~SPLIT_HEIGHT tại safe-line gần nhất, có thể cắt trúng khe hẹp → mất ngữ cảnh).
#
# Run hàng "an toàn" phải dày ≥ ngưỡng này (px) mới đủ tư cách làm điểm cắt (gutter thật,
# không phải khe hẹp trong lòng panel).
MIN_GUTTER_HEIGHT=24
# Không cắt trước ngưỡng này (px) — giữ trọn nhân vật + bong bóng của nó trong một band.
# Bỏ trống → suy từ SPLIT_HEIGHT (0.6 × SPLIT_HEIGHT).
#MIN_BAND_HEIGHT=960
# Buộc cắt khi band vượt ngưỡng này (px) — chặn band quá cao làm chữ nát khi thu về MAX_EDGE.
# Bỏ trống → suy từ SPLIT_HEIGHT (1.4 × SPLIT_HEIGHT).
#MAX_BAND_HEIGHT=2240
# Band có mật độ mực (tỉ lệ pixel không-trắng) dưới ngưỡng này → gộp vào band liền kề
# (diệt band gần trắng thừa).
MIN_INK_DENSITY=0.02
# (Tương thích ngược) SPLIT_HEIGHT chỉ còn dùng để SUY min/max band khi hai biến trên bỏ trống.
# Mặc định 1600 ≈ 2× bề rộng slice webtoon phổ biến (800px) → min 960, max 2240.
SPLIT_HEIGHT=1600
# Hàng "an toàn" khi chênh lệch 2 pixel liền kề ≤ ngưỡng này (0-255). (90% sensitivity → 25.)
LINE_TOLERANCE=25
# Bỏ qua N px sát mép trái/phải khi xét safe-line (viền, watermark dọc mép).
IGNORABLE_BORDER=5

# ==== Kịch bản AI (Stage 2 — biên kịch) ====
# Model text viết kịch bản recap (gộp/tách band thành đoạn kể). Mặc định gpt-4o.
# Z.AI: glm-4.6 / glm-4.5-air (model text, KHÔNG dùng model OpenAI trên Z.AI).
SCRIPT_MODEL=gpt-4o

# Mặc định biên kịch dùng chung OPENAI_API_KEY/OPENAI_BASE_URL với vision.
# Chỉ đặt 2 biến dưới khi biên kịch dùng NHÀ CUNG CẤP KHÁC vision.
#SCRIPT_API_KEY=
#SCRIPT_BASE_URL=

# Tắt thinking/reasoning cho model biên kịch (mẫu VISION_DISABLE_THINKING).
SCRIPT_DISABLE_THINKING=false

# ==== Trần token output (áp cho CẢ vision lẫn biên kịch) ====
# Để trống = giữ mặc định của endpoint. Đặt khi log hiện "finish_reason=length": model
# reasoning (Gemini 2.5, GLM) đốt ngân sách output vào phần suy nghĩ nên JSON bị cắt giữa
# chừng và parse hỏng. Đặt cao — trần thấp làm cắt sớm hơn, không chữa được gì.
#MODEL_MAX_TOKENS=16384

# ==== TTS (Stage 2 — giọng đọc) ====
# Provider mặc định khi project không chọn riêng. Giá trị: elevenlabs | capcut.
# (CapCut cấu hình ở block "TTS CapCut" bên dưới — thêm từ Phase 3.)
TTS_PROVIDER=elevenlabs

# ==== TTS ElevenLabs ====
# Bắt buộc khi synth audio bằng ElevenLabs (preview "có audio" + CLI render không --dry-run).
ELEVENLABS_API_KEY=

# Giọng đọc. Mặc định Rachel (21m00Tcm4TlvDq8ikWAM) — chọn giọng Việt ở voice library.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Model TTS — cả 3 tier chọn được qua ENV, đổi không sửa code:
#   eleven_multilingual_v2  (mặc định — chất lượng cao nhất)
#   eleven_turbo_v2_5       (rẻ ~50%, chất lượng gần v2)
#   eleven_flash_v2_5       (nhanh nhất — bản nháp)
ELEVENLABS_MODEL=eleven_multilingual_v2

# Endpoint — chỉ đổi khi test với mock server.
#ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# ==== TTS CapCut ====
# CapCut là API NỘI BỘ reverse-engineered (free, có giọng Việt) — KHÔNG chính thức, có thể
# ngừng hoạt động bất cứ lúc nào. Khi đó đổi TTS_PROVIDER=elevenlabs (đường lùi). Không cần
# API key. Bật bằng TTS_PROVIDER=capcut (hoặc chọn CapCut trong UI cho từng project).
# Giọng mặc định khi project/không truyền voiceId (xem catalog giọng verify trong UI):
CAPCUT_VOICE=BV074_streaming
# resource_id mặc định (chỉ dùng khi CAPCUT_VOICE không nằm trong catalog gắn sẵn):
CAPCUT_RESOURCE_ID=7102355709945188865
# Device profile tuỳ chọn (path file JSON) — override profile mặc định nhúng trong code:
#CAPCUT_DEVICE_JSON=
# Endpoint — chỉ đổi khi test với mock server.
#CAPCUT_BASE_URL=https://editor-api-sg.capcutapi.com

# Cache TTS trên đĩa (hash theo text+voice+model): preview synth 1 lần, CLI tái dùng,
# không gọi API lần 2. An toàn xoá để làm mới.
TTS_CACHE_DIR=.cache/tts
